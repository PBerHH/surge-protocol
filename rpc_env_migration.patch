diff --git a/frontend/.env.example b/frontend/.env.example
new file mode 100644
index 0000000..89debc2
--- /dev/null
+++ b/frontend/.env.example
@@ -0,0 +1,7 @@
+# Copy to frontend/.env for local dev (never commit .env — already gitignored).
+# In Vercel: Project Settings -> Environment Variables -> add VITE_RPC_URL.
+# Must be prefixed with VITE_ or Vite won't expose it to the browser build.
+# Note: this value ends up in the shipped JS bundle (visible in browser
+# devtools) same as before -- moving it here only gets it out of git/GitHub,
+# it does not make it secret from site visitors. That's expected/normal.
+VITE_RPC_URL=https://sui-mainnet.core.chainstack.com/<your-token-here>
diff --git a/frontend/src/main.jsx b/frontend/src/main.jsx
index 277dd00..3013b1a 100644
--- a/frontend/src/main.jsx
+++ b/frontend/src/main.jsx
@@ -13,8 +13,18 @@ const queryClient = new QueryClient();
 // now points at a dead endpoint. Chainstack still serves JSON-RPC during the
 // transition (full removal from node software isn't until mid-Oct 2026), so
 // pointing directly at that URL restores the site with zero other changes.
+//
+// URL comes from a Vite build-time env var (set VITE_RPC_URL in Vercel
+// project settings) instead of being committed to source. Keep the same
+// token-in-path format Chainstack issues — a prior attempt to switch to a
+// Basic-Auth (user:pass@) URL broke prod, since both browser fetch() and
+// Node's undici reject URLs with embedded credentials per the Fetch spec.
+// The fallback below is only a safety net for local dev before the env var
+// is set; once VITE_RPC_URL is live on Vercel this hardcoded value is dead
+// code and should be deleted (and the token rotated in the Chainstack
+// dashboard, since it was previously exposed in git history).
 const networks = {
-  mainnet: { url: "https://sui-mainnet.core.chainstack.com/396f310746ca72e8a7912556ef34da94" },
+  mainnet: { url: import.meta.env.VITE_RPC_URL || "https://sui-mainnet.core.chainstack.com/396f310746ca72e8a7912556ef34da94" },
 };
 
 ReactDOM.createRoot(document.getElementById("root")).render(
diff --git a/scripts/.env.example b/scripts/.env.example
new file mode 100644
index 0000000..5389457
--- /dev/null
+++ b/scripts/.env.example
@@ -0,0 +1,12 @@
+# Copy to scripts/.env for local dev (never commit .env — already gitignored).
+# In Fly.io: fly secrets set RPC_URL="..." -a surge-crank
+#            fly secrets set RPC_URL="..." -a surge-points
+RPC_URL=https://sui-mainnet.core.chainstack.com/<your-token-here>
+
+# Existing required vars (crank.js / points-worker.js) — unchanged, listed
+# here for completeness so this file is a full local-dev template.
+NETWORK=mainnet
+PACKAGE_ID=
+PACKAGE_TYPE_ID=
+SUPABASE_URL=
+SUPABASE_SECRET_KEY=
